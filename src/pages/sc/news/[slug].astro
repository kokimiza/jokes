---
import { readFileSync } from "node:fs";
import type { MarkdownInstance } from "astro";
import TermNotes from "../../../components/book/TermNotes.astro";
import { SC_BOOK, SC_CHAPTERS, chapterHref } from "../../../lib/sc-book";
import "../../../styles/book.css";
import "../../../styles/news.css";

export function getStaticPaths() {
  return SC_CHAPTERS.map((chapter) => ({ params: { slug: chapter.slug }, props: { chapter } }));
}

type Chapter = (typeof SC_CHAPTERS)[number];
type Frontmatter = { title: string; description: string; time: number; bookGlossary?: string[] };
const { chapter } = Astro.props as { chapter: Chapter };
const pages = import.meta.glob<MarkdownInstance<Frontmatter>>("../../blog/sc_*.md", { eager: true });
const page = pages[`../../blog/${chapter.slug}.md`];
const { frontmatter } = page;
const sections = page.getHeadings().filter((heading) => heading.depth === 2);
const next = SC_CHAPTERS[chapter.number];
const men = (number: number) => "一二三四五六七八"[number - 1];
const newsHref = (slug: string) => `/sc/news/${slug}/`;
const escapeHTML = (text: string) => text.replace(/[&<>"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[char]!);

// Stand short numbers and capitals upright in vertical lines. Code and tables stay horizontal.
function vertical(html: string) {
  let horizontal = 0;
  return html.split(/(<[^>]*>)/).map((part) => {
    if (/^<(pre|code|table)\b/.test(part)) horizontal++;
    else if (/^<\/(pre|code|table)>/.test(part)) horizontal--;
    else if (!part.startsWith("<") && !horizontal) {
      return part.replace(/(?<![\w.#&/-])(\d{1,2}|[A-Z]{1,4})(?![\w.])/g, (token) => `<span class="${/\d/.test(token) ? "tcy" : "upright"}">${token}</span>`);
    }
    return part;
  }).join("");
}

let headline = 0;
const body = vertical((await page.compiledContent())
  .replace(/<h2/g, () => `<h2 data-look="${headline++ % 3}"`)
  .replace(/(<h2[^>]*>)(\d+)\.\s*/g, '$1<span class="news-no">第$2節</span>')
  .replace(/(<h3[^>]*>)\d+\.\d+\s*/g, "$1")
  // A vertical float lets text run under the figure; a horizontal float would spill across pages.
  .replace(/<pre[\s\S]*?<\/pre>/g, (pre) => `<div class="news-figure">${pre}</div>`)
  .replaceAll("<table>", '<div class="news-figure"><div class="news-table"><table>')
  .replaceAll("</table>", "</table></div></div>")
  .replace(/href="\/blog\/(sc_[1-8])\/?/g, 'href="/sc/news/$1/'));

// 図解の数字は記述70問の一覧から作る。1問が複数の章にまたがることがある。
const rows = readFileSync("public/sc/past-exam-map.csv", "utf8").replace(/^﻿/, "").trim().split(/\r?\n/).slice(1).map((line) => line.split(","));
const covers = (row: string[], number: number) => row[7].split(";").includes(String(number));
const related = chapter.number >= 2 && chapter.number <= 7 ? rows.filter((row) => covers(row, chapter.number)) : rows;
const chart = chapter.number === 1
  ? { title: "記述70問は、どの章の題材か", bars: SC_CHAPTERS.slice(1, 7).map((item) => ({ label: item.title, value: rows.filter((row) => covers(row, item.number)).length })) }
  : { title: chapter.number === 8 ? "年度ごとの記述問題" : "この面の題材が出た記述問題", bars: [...new Set(rows.map((row) => row[0]))].map((year) => ({ label: `${year}年度`, value: related.filter((row) => row[0] === year).length })) };
const peak = Math.max(...chart.bars.map((bar) => bar.value));
const stats = [
  ["読む時間", frontmatter.time, "分"],
  ["節", sections.length, ""],
  ["ことば", frontmatter.bookGlossary?.length ?? 0, "語"],
  ["関わる記述問題", related.length, "問"],
] as const;

const [year, month, day] = SC_BOOK.revised.split("-").map(Number);
const weekday = "日月火水木金土"[new Date(Date.UTC(year, month - 1, day)).getUTCDay()];
---

<!doctype html>
<html lang="ja" data-reader-theme="paper">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={frontmatter.description} />
    <meta name="theme-color" content="#f3f0e8" />
    <title>{`第${men(chapter.number)}面 ${chapter.title}｜支援士新聞`}</title>
    <link rel="canonical" href={new URL(chapterHref(chapter.slug), Astro.site ?? "https://jocarium.productions")} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Same saved preferences as the book view, applied before paint.
      document.documentElement.classList.add("news-js");
      try {
        const preferences = JSON.parse(localStorage.getItem("sc-reader-settings") || "{}");
        document.documentElement.dataset.readerTheme = ["paper", "light", "dark"].includes(preferences.theme) ? preferences.theme : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "paper";
        const sizes = { small: "1rem", standard: "1.125rem", large: "1.25rem" };
        if (Object.hasOwn(sizes, preferences.size)) document.documentElement.style.setProperty("--reader-font-size", sizes[preferences.size]);
      } catch {}
    </script>
  </head>
  <body class="book-reader news">
    <a class="skip-link" href="#book-prose">本文へ移動</a>
    <div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>
    <header class="book-topbar">
      <a class="book-brand" href={newsHref("sc_1")} aria-label="支援士新聞 第一面へ">
        <span class="book-emblem" aria-hidden="true">新</span>
        <span>支援士新聞<small>第{men(chapter.number)}面・{chapter.title}</small></span>
      </a>
      <nav class="news-pages" aria-label="面を選ぶ">
        {SC_CHAPTERS.map((item) => <a href={newsHref(item.slug)} aria-current={item.slug === chapter.slug ? "page" : undefined} aria-label={`第${men(item.number)}面 ${item.title}`}>{men(item.number)}</a>)}
      </nav>
      <nav class="view-switch" aria-label="表示形式">
        <a href={chapterHref(chapter.slug)}>本</a><a href={newsHref(chapter.slug)} aria-current="page">新聞</a>
      </nav>
    </header>

    <main class="news-paper" id="news-paper" tabindex="-1" aria-label="紙面。右から左へ読みます">
      <header class="news-masthead">
        <p class="news-title">支援士新聞</p>
        <p class="news-dateline" set:html={vertical(`${year}年（令和${year - 2018}年）<br>${month}月${day}日　${weekday}曜日`)} />
        <p class="news-folio">第{men(chapter.number)}面</p>
        <nav class="news-index" aria-label="この面の記事">
          <p>この面の記事</p>
          <ol>{sections.map((section) => <li><a href={`#${section.slug}`} set:html={vertical(escapeHTML(section.text.replace(/^(\d+)\.\s*/, "$1　")))} /></li>)}</ol>
        </nav>
      </header>

      <header class="news-hero">
        <p class="news-kicker" set:html={vertical(`${chapter.group}　第${chapter.number}章`)} />
        <h1 set:html={vertical(escapeHTML(frontmatter.title))} />
        <p class="news-sub" set:html={vertical(escapeHTML(chapter.subtitle))} />
      </header>

      <aside class="news-graphics" aria-label="図解">
        <figure class="news-chart">
          <figcaption><b>図解</b>{chart.title}</figcaption>
          <dl>{chart.bars.map((bar) => <div><dt>{bar.label}</dt><dd style={`--share:${bar.value / peak}`} data-peak={bar.value === peak ? "" : undefined}>{bar.value}</dd></div>)}</dl>
          <p>2018〜2025年度の記述{rows.length}問から集計。<a href="/sc/past-exam-map.csv">一覧（CSV）</a></p>
        </figure>
        <section class="news-stats" aria-label="数字で見るこの面">
          <p>数字で見るこの面</p>
          <dl>{stats.map(([label, value, unit]) => <div><dt>{label}</dt><dd><b>{value}</b>{unit}</dd></div>)}</dl>
        </section>
        {chapter.number === 1 && <figure class="news-flow">
          <figcaption>知識を整理する順序</figcaption>
          <ol>{["正常な処理", "受信者の検証", "攻撃", "証拠", "復旧"].map((step) => <li>{step}</li>)}</ol>
        </figure>}
      </aside>

      <div class="news-body" id="book-prose">
        <p class="news-lead" set:html={vertical(escapeHTML(frontmatter.description))} />
        <aside class="news-guide"><b>読み方</b><span set:html={vertical(escapeHTML(chapter.guide))} /></aside>
        <Fragment set:html={body} />
      </div>
      <TermNotes ids={frontmatter.bookGlossary ?? []} />

      <footer class="news-end">
        <a class="news-next" href={newsHref(next?.slug ?? "sc_1")}>
          <small>{next ? "次の面へ" : "第一面へ戻る"}</small>
          <span set:html={vertical(escapeHTML(next ? `第${men(next.number)}面　${next.title}` : SC_CHAPTERS[0].title))} />
        </a>
        <a href={chapterHref(chapter.slug)}>この章を本の体裁で読む</a>
        <p class="news-colophon" set:html={vertical(`${year}年${month}月${day}日改訂・Yu Tokunaga`)} />
      </footer>
    </main>

    <button class="news-turn" type="button" data-turn="back" aria-label="前へ戻す" data-js-only>→</button>
    <button class="news-turn" type="button" data-turn="forward" aria-label="次へ送る" data-js-only>←</button>
    <script src="../../../scripts/book-terms.ts"></script>
    <script>
      // Vertical-rl scrolls from 0 at the right edge to negative values on the left.
      const paper = document.getElementById("news-paper")!;
      const bar = document.getElementById("reading-progress-bar");
      const back = document.querySelector<HTMLButtonElement>('[data-turn="back"]')!;
      const forward = document.querySelector<HTMLButtonElement>('[data-turn="forward"]')!;
      const behavior: ScrollBehavior = matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
      const page = () => paper.clientWidth * 0.85;
      const end = () => paper.scrollWidth - paper.clientWidth;
      document.documentElement.classList.add("js-ready");

      // 紙面割り：本文を一頁ずつの箱（段組み）へ流し込み、溢れた段落や箇条書きは文字の位置で二つに割る。
      // CSS の column-wrap に頼らないので、どのブラウザーでも同じ段組みになる。
      const flow = document.getElementById("book-prose")!;
      const blocks = Array.from(flow.children) as HTMLElement[];
      const answers = blocks.flatMap((block) => Array.from(block.matches("details") ? [block] : block.querySelectorAll("details"))) as HTMLDetailsElement[];
      answers.forEach((details, index) => { details.dataset.answer = String(index); });
      const range = document.createRange();
      const splittable = "p, ul, ol, blockquote, details[open]";

      // A block overflows when some of its text was pushed into a tier below the page.
      function overflows(block: Element, limit: number) {
        range.selectNodeContents(block);
        return Array.from(range.getClientRects()).some((rect) => rect.height > 0 && rect.top >= limit);
      }

      function split(block: HTMLElement, limit: number): [HTMLElement, HTMLElement] | null {
        const chars: [Text, number][] = [];
        const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
        for (let node = walker.nextNode() as Text | null; node; node = walker.nextNode() as Text | null) {
          if (node.parentElement?.closest(".tcy, summary")) { if (node.data.trim()) chars.push([node, 0]); continue; }
          for (let i = 0; i < node.data.length; i++) if (node.data[i].trim()) chars.push([node, i]);
        }
        const fits = ([node, offset]: [Text, number]) => {
          range.setStart(node, offset);
          range.setEnd(node, offset + 1);
          return range.getBoundingClientRect().top < limit;
        };
        let low = 0;
        let high = chars.length;
        while (low < high) {
          const mid = (low + high) >> 1;
          if (fits(chars[mid])) low = mid + 1;
          else high = mid;
        }
        if (low === 0 || low === chars.length) return null;
        const [node, offset] = chars[low];
        // Cut before the outermost element that starts exactly at the break, so no empty item is left behind.
        let cut: Node | null = null;
        for (let parent = node.parentNode; parent && parent !== block; parent = parent.parentNode) {
          range.setStart(parent, 0);
          range.setEnd(node, offset);
          if (!range.toString().trim()) cut = parent;
        }
        const item = node.parentElement?.closest("li");
        const list = item && block.contains(item) ? item.parentElement : null;
        const index = list && item ? Array.from(list.children).indexOf(item) : 0;
        const paragraph = node.parentElement?.closest("p, li");
        const broken = paragraph && block.contains(paragraph) && !(cut && cut.contains(paragraph)) ? paragraph : null;
        range.setStart(block, 0);
        if (cut) range.setEndBefore(cut);
        else range.setEnd(node, offset);
        const head = block.cloneNode(false) as HTMLElement;
        head.append(range.extractContents());
        block.removeAttribute("id");
        broken?.classList.add("cont");
        if (list instanceof HTMLOListElement) list.start += index;
        if (!(block instanceof HTMLDetailsElement)) return [head, block];
        const rest = document.createElement("div");
        rest.className = "details-cont";
        rest.append(...Array.from(block.childNodes));
        return [head, rest];
      }

      function fillPage(queue: HTMLElement[]) {
        const sheet = flow.appendChild(document.createElement("div"));
        sheet.className = "news-page";
        const limit = sheet.getBoundingClientRect().bottom - 1;
        const columns = getComputedStyle(sheet);
        const tiers = Number.parseInt(columns.columnCount, 10) || 1;
        const tier = (sheet.clientHeight - (tiers - 1) * Number.parseFloat(columns.columnGap)) / tiers;
        const room = 6 * Number.parseFloat(getComputedStyle(flow).fontSize);
        const deferred: HTMLElement[] = [];
        // Figures that miss the page wait for the next one while text fills the gap, but never past a new section.
        const blocked = () => deferred.length > 0 && queue[0]?.matches("h2");
        for (;;) {
          for (let budget = 0; queue.length && budget < 1600 && !blocked();) {
            const block = queue.shift()!;
            sheet.append(block);
            budget += (block.textContent?.length ?? 0) + 40;
          }
          // Too little room under a figure gives one-character lines; let the figure take the whole tier.
          for (const figure of sheet.querySelectorAll<HTMLElement>(".news-figure:not(.full)")) {
            if (tier - figure.offsetHeight < room) {
              figure.classList.add("full");
              figure.style.height = `${tier - 1}px`;
            }
          }
          const over = Array.from(sheet.children).find((child) => overflows(child, limit)) as HTMLElement | undefined;
          if (!over) {
            if (queue.length && !blocked()) continue;
            break;
          }
          while (sheet.lastElementChild !== over) {
            const later = sheet.lastElementChild as HTMLElement;
            later.remove();
            queue.unshift(later);
          }
          if (over.matches(".news-figure") && over !== sheet.firstElementChild) {
            over.remove();
            deferred.push(over);
            continue;
          }
          const parts = over.matches(splittable) ? split(over, limit) : null;
          if (parts) {
            over.replaceWith(parts[0]);
            queue.unshift(parts[1]);
          } else if (over !== sheet.firstElementChild) {
            over.remove();
            queue.unshift(over);
          }
          break;
        }
        // A headline never closes a page.
        const last = sheet.lastElementChild as HTMLElement | null;
        if (last?.matches("h2, h3") && last !== sheet.firstElementChild) {
          last.remove();
          queue.unshift(last);
        }
        queue.unshift(...deferred);
      }

      function paginate(anchor?: HTMLElement) {
        const key = anchor?.dataset.answer;
        const before = anchor?.getBoundingClientRect().right ?? 0;
        const read = end() > 0 ? -paper.scrollLeft / end() : 0;
        const queue = blocks.map((block) => block.cloneNode(true) as HTMLElement);
        flow.replaceChildren();
        while (queue.length) fillPage(queue);
        flow.dataset.paged = "";
        const again = key === undefined ? null : flow.querySelector(`[data-answer="${key}"]`);
        if (again) paper.scrollLeft += again.getBoundingClientRect().right - before;
        else paper.scrollLeft = -read * end();
        update();
      }

      // Opening an answer changes its length, so the pages are laid out again around it.
      flow.addEventListener("toggle", (event) => {
        const details = event.target as HTMLDetailsElement;
        const original = answers[Number(details.dataset.answer)];
        if (!original || original.open === details.open) return;
        original.open = details.open;
        paginate(details);
      }, true);

      function update() {
        const read = end() > 0 ? Math.min(1, -paper.scrollLeft / end()) : 1;
        if (bar) bar.style.width = `${read * 100}%`;
        back.disabled = paper.scrollLeft > -2;
        forward.disabled = read > 0.998;
      }
      paper.addEventListener("scroll", update, { passive: true });

      // Page turns line a sheet up with the right edge instead of moving a fixed distance.
      function turn(direction: 1 | -1) {
        const view = paper.getBoundingClientRect();
        const start = view.right - Number.parseFloat(getComputedStyle(paper).paddingRight);
        const sheets = Array.from(paper.querySelectorAll<HTMLElement>(":scope > :not(.news-body), .news-page"));
        const shifts = sheets.map((sheet) => sheet.getBoundingClientRect().right - start);
        let shift: number | undefined;
        if (direction > 0) {
          const ahead = shifts.filter((value) => value < -2);
          const seen = ahead.filter((value) => value + start > view.left + 8);
          shift = seen.length ? Math.min(...seen) : ahead.length ? Math.max(...ahead) : undefined;
        } else {
          const behind = shifts.filter((value) => value > 2);
          const near = behind.filter((value) => value <= start - view.left);
          shift = near.length ? Math.max(...near) : behind.length ? Math.min(...behind) : undefined;
        }
        paper.scrollBy({ left: shift ?? -direction * page(), behavior });
      }
      back.addEventListener("click", () => turn(-1));
      forward.addEventListener("click", () => turn(1));

      let size = "";
      let timer = 0;
      document.fonts.ready.then(() => {
        paginate();
        size = `${paper.clientWidth}x${paper.clientHeight}`;
        if (location.hash) document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
        update();
        new ResizeObserver(() => {
          const now = `${paper.clientWidth}x${paper.clientHeight}`;
          if (now === size) return;
          size = now;
          clearTimeout(timer);
          timer = window.setTimeout(() => paginate(), 150);
        }).observe(paper);
      });

      // Wheel and arrow keys move the page leftward, the way the text runs.
      const inScroller = (target: EventTarget | null) => {
        const box = target instanceof Element ? target.closest<HTMLElement>("pre, .news-table, .term-popover") : null;
        return !!box && box.scrollHeight > box.clientHeight;
      };
      paper.addEventListener("wheel", (event) => {
        if (event.ctrlKey || Math.abs(event.deltaX) >= Math.abs(event.deltaY) || inScroller(event.target)) return;
        event.preventDefault();
        paper.scrollLeft -= event.deltaY * (event.deltaMode === 1 ? 40 : event.deltaMode === 2 ? page() : 1);
      }, { passive: false });
      document.addEventListener("keydown", (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (event.altKey || event.ctrlKey || event.metaKey || target?.closest("input, select, textarea, pre, .news-table, .term-popover")) return;
        if (event.key === " " && target?.closest("a, button, summary")) return;
        if (event.key === "Home" || event.key === "End") {
          event.preventDefault();
          paper.scrollTo({ left: event.key === "Home" ? 0 : -end(), behavior });
          return;
        }
        if (event.key === "PageDown" || event.key === "PageUp" || event.key === " ") {
          event.preventDefault();
          turn(event.key === "PageUp" || (event.key === " " && event.shiftKey) ? -1 : 1);
          return;
        }
        const distance = { ArrowLeft: 80, ArrowDown: 80, ArrowRight: -80, ArrowUp: -80 }[event.key];
        if (distance === undefined) return;
        event.preventDefault();
        paper.scrollBy({ left: -distance });
      });
    </script>
  </body>
</html>
